---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import '../styles/global.css';
import '../styles/tokens.css';
import '../styles/header.css';
import '../styles/footer.css';
import Header from './Header.astro';
import AuthGate from './AuthGate.astro';
import Footer from './Footer.astro';

interface Props {
  caso: any;
  locale?: 'es' | 'en' | 'ca';
}

const { caso, locale = 'es' } = Astro.props;
// Los campos de texto se toman de `traducciones[locale]` cuando existen; si no, del español.
const c = { ...caso.data, ...(locale !== 'es' ? caso.data.traducciones?.[locale] ?? {} : {}) };

const ui = {
  es: { badge: 'Caso de éxito', back: '← Volver a casos de éxito', imageTag: 'Creatividad emitida', imageAlt: (t: string) => `Creatividad de ${t} emitida en los canales de Atresmedia`, placeholder: 'Fotograma real de la creatividad emitida, pendiente de sustituir por la captura del anuncio.', dataTitle: 'Datos de la campaña', termLabel: 'Datos del caso', termBar: 'caso', location: 'ubicación', product: 'producto', result: 'resultado', postalCodes: 'cód. postales', coverage: 'Zona de cobertura', coverageCampaign: 'Zona de cobertura de la campaña', cta: 'Quiero un caso como este', titleSuffix: 'Caso de éxito' },
  en: { badge: 'Success story', back: '← Back to success stories', imageTag: 'Broadcast creative', imageAlt: (t: string) => `${t} creative aired on Atresmedia channels`, placeholder: 'Real frame of the broadcast creative, to be replaced with the ad capture.', dataTitle: 'Campaign data', termLabel: 'Case data', termBar: 'case', location: 'location', product: 'product', result: 'result', postalCodes: 'postcodes', coverage: 'Coverage area', coverageCampaign: 'Campaign coverage area', cta: 'I want a case like this', titleSuffix: 'Success story' },
  ca: { badge: 'Cas d’èxit', back: '← Tornar als casos d’èxit', imageTag: 'Creativitat emesa', imageAlt: (t: string) => `Creativitat de ${t} emesa als canals d’Atresmedia`, placeholder: 'Fotograma real de la creativitat emesa, pendent de substituir per la captura de l’anunci.', dataTitle: 'Dades de la campanya', termLabel: 'Dades del cas', termBar: 'cas', location: 'ubicació', product: 'producte', result: 'resultat', postalCodes: 'codis postals', coverage: 'Zona de cobertura', coverageCampaign: 'Zona de cobertura de la campanya', cta: 'Vull un cas com aquest', titleSuffix: 'Cas d’èxit' },
}[locale];
// Mapa SVG del municipio (public/images/casos/mapa-<nombre>.svg, ver scripts/generar-mapas.py): se incrusta en el HTML y evita cargar Leaflet.
// Con `codigosPostales` en el caso se usa el mapa por códigos postales (mapa-<nombre>-cp.svg) y solo se ilumina lo indicado; sin él, se ilumina el municipio entero.
const cps: string[] = c.codigosPostales ?? [];
const svgName = c.mapa ? (cps.length ? `mapa-${c.mapa}-cp.svg` : `mapa-${c.mapa}.svg`) : '';
const mapaSvg = c.mapa
  ? readFileSync(join(process.cwd(), 'public', 'images', 'casos', svgName), 'utf-8')
      .replace(/<\?xml[^>]*\?>\s*/, '')
      .replace(/<path ([^>]*?)class="distrito"([^>]*?)\/>/g, (_m: string, a: string, b: string) => {
        const id = /id="cp-(\d+)"/.exec(a + b)?.[1];
        const active = !cps.length || (id !== undefined && cps.includes(id));
        return active
          ? `<path ${a}class="distrito is-active"${b}/><path ${a}class="traza" pathLength="100"${b}/>`
          : `<path ${a}class="distrito"${b}/>`;
      })
  : '';
const useLeaflet = !c.mapa && c.lat && c.lng;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resultadoTexto = `${c.resultadoPrefijo}${c.resultadoValor.toFixed(c.resultadoDecimales)}${c.resultadoSufijo}`;
const homePrefix = locale === 'es' ? '' : `/${locale}`;

---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <AuthGate />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={c.descripcion} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preload" href={`${base}/fonts/gothampro-regular.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}/fonts/gothampro-bold.woff2`} as="font" type="font/woff2" crossorigin />
    {useLeaflet && (
      <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" integrity="sha512-h9FcoyWjHcOcmEVkxOfTLnmZFWIH0iZhZT1H2TbOq55xssQGEJHEaIm+PgoUaZbRvQTNTluNOEfb1ZRy6D3BOw==" crossorigin="" />
    )}
    <title>{c.titulo} · {ui.titleSuffix} | +CercaTV</title>
  </head>
  <body class="page-wide">
    <Header locale={locale} />
    <main>
      <section class="case-story" aria-labelledby="case-story-title">
        <a class="case-story__back" href={`${base}/casos-de-exito`}>{ui.back}</a>

        <div class="case-story__layout">
          <div class="case-story__main">
            <div class="case-story__intro">
            <div class="case-story__head">
              <span class="case-tile__badge">{ui.badge} · {c.index}</span>
              <span class="case-story__category">{c.categoria}</span>
            </div>

            <h1 id="case-story-title">{c.titulo}</h1>
            <p class="case-story__subtitle">{c.subtitulo}</p>
            <p class="case-story__description">{c.descripcion}</p>
            </div>

            <div class="case-story__image">
              <span class="case-story__image-tag">{ui.imageTag}</span>
              {c.imagen ? (
                <img class="case-story__image-photo" src={`${base}/images/casos/${c.imagen}`} alt={ui.imageAlt(c.titulo)} loading="lazy" />
              ) : (
                <span class="case-story__image-placeholder">{ui.placeholder}</span>
              )}
            </div>
          </div>

          <h2 class="case-story__data-title" id="case-data-title">{ui.dataTitle} <span class="case-story__data-name">{c.titulo}</span></h2>
          <aside class="case-story__sidebar" aria-labelledby="case-data-title">
            {useLeaflet && (
              <div class="case-story__map-block">
                <span class="case-story__map-label">{ui.coverageCampaign}</span>
                <div id="case-map" class="case-story__map" data-lat={c.lat} data-lng={c.lng}></div>
              </div>
            )}

            <div class="case-term" aria-label={ui.termLabel}>
              <div class="case-term__bar"><i></i><i></i><i></i><span>{ui.termBar} · {caso.id}</span></div>
              {c.mapa && (
                <div class="case-term__map" role="img" aria-label={`${ui.coverage}: ${c.ubicacion}`}>
                  <span class="case-term__place" aria-hidden="true">{c.ubicacion.split(' (')[0]}</span>
                  {c.resultadoCorto && <span class="case-term__kpi" aria-hidden="true"><strong data-prefix={c.resultadoPrefijo} data-value={c.resultadoValor} data-suffix={c.resultadoSufijo} data-decimals={c.resultadoDecimales}>{resultadoTexto}</strong><small>{c.resultadoCorto}</small></span>}
                  <Fragment set:html={mapaSvg} />
                </div>
              )}
              <ul>
                <li><span class="prompt">&gt;</span><span class="key">{ui.location}</span><span class="msg" data-type>{c.ubicacion}</span></li>
                {cps.length > 0 && <li><span class="prompt">&gt;</span><span class="key">{ui.postalCodes}</span><span class="msg" data-type>{cps.join(', ')}</span></li>}
                <li><span class="prompt">&gt;</span><span class="key">{ui.product}</span><span class="msg" data-type>{c.producto}</span></li>
                <li class="case-term__result"><span class="prompt">&gt;</span><span class="key">{ui.result}</span><span class="msg" data-type><strong>{resultadoTexto}</strong> {c.resultadoDescripcion}</span></li>
              </ul>
            </div>

            <a class="cta-pill case-story__cta" href={`${base}${homePrefix}/#contacto`}>{ui.cta}</a>
          </aside>
        </div>
      </section>
    </main>
    <Footer locale={locale} />

    {useLeaflet && (
      <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js" integrity="sha512-puJW3E/qXDqYp9IfhAI54BJEaWIfloJ7JWs7OeD5i6ruC9JZL1gERT1wjtwXFlh7CjE7ZJ+/vcRZRkIYIb6p4g==" crossorigin=""></script>
    )}
    <script>
      const mapEl = document.getElementById('case-map');
      if (mapEl && (window as any).L) {
        const lat = Number(mapEl.dataset.lat);
        const lng = Number(mapEl.dataset.lng);
        const L = (window as any).L;
        const map = L.map('case-map', { zoomControl: false, dragging: false, scrollWheelZoom: false, doubleClickZoom: false, attributionControl: false }).setView([lat, lng], 12);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 18 }).addTo(map);
        L.circle([lat, lng], { radius: 5000, color: '#cb7721', fillColor: '#cb7721', fillOpacity: 0.12, weight: 2 }).addTo(map);
        L.circleMarker([lat, lng], { radius: 7, color: '#cb7721', fillColor: '#cb7721', fillOpacity: 1, weight: 2 }).addTo(map);
      }

      const kpi = document.querySelector<HTMLElement>('.case-term__kpi strong');
      if (kpi && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const target = Number(kpi.dataset.value);
        const decimals = Number(kpi.dataset.decimals ?? '0');
        const format = (v: number) => `${kpi.dataset.prefix ?? ''}${v.toFixed(decimals)}${kpi.dataset.suffix ?? ''}`;
        kpi.textContent = format(0);
        const kpiObserver = new IntersectionObserver((entries) => {
          if (!entries[0].isIntersecting) return;
          kpiObserver.disconnect();
          const start = performance.now();
          const step = (now: number) => {
            const p = Math.min((now - start) / 1400, 1);
            kpi.textContent = format(target * (1 - Math.pow(1 - p, 3)));
            if (p < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        }, { threshold: 0.5 });
        kpiObserver.observe(kpi);
      }

      const term = document.querySelector<HTMLElement>('.case-term');
      if (term && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const lines = [...term.querySelectorAll<HTMLElement>('li')];
        const targets = lines.map((li) => li.querySelector<HTMLElement>('[data-type]')!);
        const html = targets.map((t) => t.innerHTML);
        const texts = targets.map((t) => t.textContent ?? '');
        term.classList.add('is-typing');
        const observer = new IntersectionObserver((entries) => {
          if (!entries[0].isIntersecting) return;
          observer.disconnect();
          let i = 0;
          const next = () => {
            if (i > 0) { lines[i - 1].classList.replace('is-on', 'is-done'); targets[i - 1].innerHTML = html[i - 1]; }
            if (i >= lines.length) return;
            const li = lines[i]; const target = targets[i]; const text = texts[i]; const idx = i; i++;
            li.classList.add('is-on');
            const start = performance.now();
            const tick = (now: number) => {
              const n = Math.min(text.length, Math.floor((now - start) / 22));
              target.textContent = text.slice(0, n);
              if (n < text.length) requestAnimationFrame(tick); else setTimeout(next, 350);
            };
            requestAnimationFrame(tick);
          };
          next();
        }, { threshold: 0.5 });
        lines.forEach((li) => li.classList.remove('is-on', 'is-done'));
        targets.forEach((t) => { t.textContent = ''; });
        observer.observe(term);
      }
    </script>
  </body>
</html>

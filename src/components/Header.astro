---
interface Props {
  locale?: 'es' | 'en' | 'ca';
}

const { locale = 'es' } = Astro.props;

const translations = {
  es: { about: 'Quiénes somos', media: '+Cerca Media', exclusivity: 'Exclusividad con Atresmedia', solutions: 'Soluciones', cases: 'Casos de éxito', greeting: '', cta: 'FAQ\'s', menu: 'Menú', close: 'Cerrar', navigation: 'Navegación', appearance: 'Apariencia', dark: 'Oscuro', light: 'Claro' },
  en: { about: 'About us', media: '+Cerca Media', exclusivity: 'Exclusivity with Atresmedia', solutions: 'Solutions', cases: 'Success stories', greeting: '', cta: 'FAQs', menu: 'Menu', close: 'Close', navigation: 'Navigation', appearance: 'Appearance', dark: 'Dark', light: 'Light' },
  ca: { about: 'Qui som', media: '+Cerca Media', exclusivity: 'Exclusivitat amb Atresmedia', solutions: 'Solucions', cases: 'Casos d’èxit', greeting: '', cta: 'FAQ\'s', menu: 'Menú', close: 'Tanca', navigation: 'Navegació', appearance: 'Aparença', dark: 'Fosc', light: 'Clar' },
};

const translation = translations[locale];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = (p: string) => `${base}${p}`;

const items = [
  { label: translation.about, href: path('/quienes-somos') },
  { label: translation.media, href: path('/mas-cerca-media') },
  { label: translation.exclusivity, href: path('/exclusividad-atresmedia') },
  { label: translation.solutions, href: path('/soluciones') },
  { label: translation.cases, href: path('/casos-de-exito') },
];

// Al cambiar de idioma, mantener la misma página actual (solo cambia el prefijo de idioma en la ruta).
const currentPathNoBase = (() => {
  const full = Astro.url.pathname;
  const stripped = base && full.startsWith(base) ? full.slice(base.length) : full;
  return stripped.startsWith('/') ? stripped : `/${stripped}`;
})();

const pathWithoutLocale = (() => {
  if (currentPathNoBase === '/en' || currentPathNoBase.startsWith('/en/')) {
    return currentPathNoBase.slice(3) || '/';
  }
  if (currentPathNoBase === '/ca' || currentPathNoBase.startsWith('/ca/')) {
    return currentPathNoBase.slice(3) || '/';
  }
  return currentPathNoBase;
})();

// Solo la home y el caso de Motor Dye existen traducidos en los 3 idiomas por ahora. El resto de páginas
// (casos de éxito, etc.)
// solo existen en español, así que el selector de idioma debe quedarse en la versión en español
// de esa misma página en vez de romper en un 404.
const translatedPaths = ['/', '/casos-de-exito/motor-dye'];
const hasTranslations = translatedPaths.includes(pathWithoutLocale);

const hrefForLocale = (code: 'es' | 'en' | 'ca') => {
  if (code === 'es' || !hasTranslations) return path(pathWithoutLocale);
  return path(`/${code}${pathWithoutLocale}`);
};

const languages = [
  { code: 'es' as const, shortLabel: 'ES', longLabel: 'Español', href: hrefForLocale('es') },
  { code: 'en' as const, shortLabel: 'EN', longLabel: 'English', href: hrefForLocale('en') },
  { code: 'ca' as const, shortLabel: 'CA', longLabel: 'Català', href: hrefForLocale('ca') },
];

const homeHref = path(locale === 'es' ? '/' : `/${locale}/`);
---

<header class="site-header" data-site-header data-base={base}>
  <div class="site-header__inner">
    <a class="site-header__logo" href={homeHref} aria-label="+CercaTV, ir al inicio">
      <img src={path('/images/brand/cercatv-logo-color.svg')} width="609" height="201" alt="Atresmedia +CercaTV" />
    </a>

    <nav class="site-header__nav" aria-label="Navegación principal">
      {items.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="site-header__actions">
      <button class="theme-switcher" type="button" data-theme-toggle data-dark-label={translation.dark} data-light-label={translation.light} aria-pressed="false">
        <svg class="theme-switcher__icon theme-switcher__icon--moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
        <svg class="theme-switcher__icon theme-switcher__icon--sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4 12H2M22 12h-2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <span class="theme-switcher__label">{translation.dark}</span>
      </button>
      <div class="language-menu-wrap" id="language-menu-wrap" data-language-menu>
        <button class="language-menu-trigger" type="button" aria-label="Cambiar idioma" aria-expanded="false" aria-controls="language-menu-panel">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="8"></circle>
            <path d="M4 12h16"></path>
            <path d="M12 4c2.1 2.2 3.1 4.9 3.1 8s-1 5.8-3.1 8"></path>
            <path d="M12 4c-2.1 2.2-3.1 4.9-3.1 8s1 5.8 3.1 8"></path>
          </svg>
          <span class="language-menu-current">{locale.toUpperCase()}</span>
        </button>
        <div class="language-menu-panel" id="language-menu-panel" role="menu" aria-label="Idioma">
          {languages.map((lang) => (
            <a href={lang.href} data-language-link role="menuitem" aria-current={locale === lang.code ? 'true' : undefined}>
              <span>{lang.longLabel}</span>
              <span class="language-menu-code">{lang.shortLabel}</span>
            </a>
          ))}
        </div>
      </div>
      <a class="site-header__cta" href={path('/preguntas-frecuentes')}>{translation.cta}</a>
      <button class="site-header__menu" type="button" aria-expanded="false" aria-controls="mobile-navigation">{translation.menu}</button>
    </div>
  </div>

  <div class="mobile-navigation" id="mobile-navigation" hidden>
    <div class="mobile-navigation__top">
      <span>{translation.navigation}</span>
      <button type="button" data-menu-close>{translation.close}</button>
    </div>
    <nav aria-label="Navegación móvil">
      {items.map((item, index) => <a href={item.href}><span>0{index + 1}</span>{item.label}</a>)}
    </nav>
    <div class="mobile-navigation__bottom">
      <div class="mobile-theme-control">
        <span>{translation.appearance}</span>
        <button class="theme-switcher theme-switcher--mobile" type="button" data-theme-toggle data-dark-label={translation.dark} data-light-label={translation.light} aria-pressed="false">
          <svg class="theme-switcher__icon theme-switcher__icon--moon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
          </svg>
          <svg class="theme-switcher__icon theme-switcher__icon--sun" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4 12H2M22 12h-2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
          <span class="theme-switcher__label">{translation.dark}</span>
        </button>
      </div>
      <div class="language-switcher language-switcher--mobile" aria-label="Seleccionar idioma">
        {languages.map((lang) => (
          <a href={lang.href} data-language-link data-mobile-language-link aria-current={locale === lang.code ? 'true' : undefined}>{lang.longLabel}</a>
        ))}
      </div>
      <a class="site-header__cta site-header__cta--mobile" href={path('/preguntas-frecuentes')}>{translation.cta}</a>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const menuButton = header?.querySelector<HTMLButtonElement>('.site-header__menu');
  const closeButton = header?.querySelector<HTMLButtonElement>('[data-menu-close]');
  const mobileNavigation = header?.querySelector<HTMLElement>('#mobile-navigation');

  const setMenu = (open: boolean) => {
    if (!menuButton || !mobileNavigation) return;
    menuButton.setAttribute('aria-expanded', String(open));
    mobileNavigation.hidden = !open;
    document.body.classList.toggle('menu-open', open);
    if (open) closeButton?.focus();
    else menuButton.focus();
  };

  menuButton?.addEventListener('click', () => setMenu(menuButton.getAttribute('aria-expanded') !== 'true'));
  closeButton?.addEventListener('click', () => setMenu(false));

  if (sessionStorage.getItem('cercatv-reopen-mobile-menu') === 'true') {
    sessionStorage.removeItem('cercatv-reopen-mobile-menu');
    setMenu(true);
  }

  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') setMenu(false);
  });

  const themeButtons = header ? [...header.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')] : [];
  const logo = header?.querySelector<HTMLImageElement>('.site-header__logo img');
  const setTheme = (theme: 'clear' | 'dark') => {
    document.body.dataset.theme = theme;
    themeButtons.forEach((button) => {
      button.setAttribute('aria-pressed', String(theme === 'dark'));
      const label = button.querySelector<HTMLElement>('.theme-switcher__label');
      const labelText = theme === 'dark' ? button.dataset.lightLabel ?? 'Claro' : button.dataset.darkLabel ?? 'Oscuro';
      if (label) label.textContent = labelText;
      else button.textContent = labelText;
    });
    const base = header?.dataset.base ?? '';
    if (logo) logo.src = theme === 'dark' ? `${base}/images/brand/cercatv-logo-dark.svg` : `${base}/images/brand/cercatv-logo-color.svg`;
    localStorage.setItem('cercatv-theme', theme);
  };
  const savedTheme = localStorage.getItem('cercatv-theme');
  if (savedTheme === 'dark') setTheme('dark');
  themeButtons.forEach((button) => button.addEventListener('click', () => setTheme(document.body.dataset.theme === 'dark' ? 'clear' : 'dark')));

  const languageMenuWrap = header?.querySelector<HTMLElement>('[data-language-menu]');
  const languageMenuTrigger = languageMenuWrap?.querySelector<HTMLButtonElement>('.language-menu-trigger');
  const closeLanguageMenu = () => {
    if (!languageMenuWrap || !languageMenuTrigger) return;
    languageMenuWrap.classList.remove('is-open');
    languageMenuTrigger.setAttribute('aria-expanded', 'false');
  };
  languageMenuTrigger?.addEventListener('click', (event) => {
    event.stopPropagation();
    const opening = !languageMenuWrap?.classList.contains('is-open');
    languageMenuWrap?.classList.toggle('is-open', opening);
    languageMenuTrigger.setAttribute('aria-expanded', String(opening));
  });
  document.addEventListener('click', (event) => {
    if (languageMenuWrap && !languageMenuWrap.contains(event.target as Node)) closeLanguageMenu();
  });
  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeLanguageMenu();
  });

  header?.querySelectorAll<HTMLAnchorElement>('[data-language-link]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const sections = [...document.querySelectorAll<HTMLElement>('[data-i18n-section]')];
      const viewportCenter = window.innerHeight / 2;
      const currentSection = sections.find((section) => {
        const bounds = section.getBoundingClientRect();
        return bounds.top <= viewportCenter && bounds.bottom >= viewportCenter;
      }) ?? sections.reduce<HTMLElement | undefined>((closest, section) => {
        const distance = Math.abs(section.getBoundingClientRect().top - viewportCenter);
        return !closest || distance < Math.abs(closest.getBoundingClientRect().top - viewportCenter) ? section : closest;
      }, undefined);
      const targetSection = currentSection?.dataset.i18nSection;
      if (!targetSection) return;
      event.preventDefault();
      if (link.hasAttribute('data-mobile-language-link') && menuButton?.getAttribute('aria-expanded') === 'true') {
        sessionStorage.setItem('cercatv-reopen-mobile-menu', 'true');
      }
      const destination = new URL(link.href);
      destination.hash = targetSection;
      window.location.assign(destination.toString());
    });
  });
</script>

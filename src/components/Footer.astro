---
interface Props {
  locale?: 'es' | 'en' | 'ca';
}

const { locale = 'es' } = Astro.props;

const translations = {
  es: { about: 'Quiénes somos', media: '+Cerca Media', exclusivity: 'Exclusividad con Atresmedia', solutions: 'Soluciones', cases: 'Casos de éxito', faq: 'FAQs', contact: 'Contacto', legal: 'Aviso Legal', privacy: 'Política de Privacidad', cookies: 'Política de Cookies', mapsLead: 'Mapas: datos abiertos de los Ayuntamientos de', mapsAnd: 'y' },
  en: { about: 'About us', media: '+Cerca Media', exclusivity: 'Exclusivity with Atresmedia', solutions: 'Solutions', cases: 'Success stories', faq: 'FAQs', contact: 'Contact', legal: 'Legal Notice', privacy: 'Privacy Policy', cookies: 'Cookie Policy', mapsLead: 'Maps: open data from the city councils of', mapsAnd: 'and' },
  ca: { about: 'Qui som', media: '+Cerca Media', exclusivity: 'Exclusivitat amb Atresmedia', solutions: 'Solucions', cases: 'Casos d’èxit', faq: 'FAQs', contact: 'Contacte', legal: 'Avís Legal', privacy: 'Política de Privacitat', cookies: 'Política de Galetes', mapsLead: 'Mapes: dades obertes dels Ajuntaments de', mapsAnd: 'i' },
};

// Línea de créditos de los mapas del hero (datos abiertos). Oculta por ahora; poner a true para mostrarla.
const SHOW_MAP_CREDITS = false;

const translation = translations[locale];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = (p: string) => `${base}${p}`;
const homeHref = { es: path('/'), en: path('/en/'), ca: path('/ca/') }[locale];

const items = [
  { label: translation.about, href: path('/quienes-somos') },
  { label: translation.media, href: path('/mas-cerca-media') },
  { label: translation.exclusivity, href: path('/exclusividad-atresmedia') },
  { label: translation.solutions, href: path('/soluciones') },
  { label: translation.cases, href: path('/casos-de-exito') },
  { label: translation.faq, href: path('/preguntas-frecuentes') },
];

const socials = [
  { label: 'X', href: '#' },
  { label: 'LinkedIn', href: '#' },
  { label: 'Instagram', href: '#' },
  { label: 'YouTube', href: '#' },
];
---

<footer class="site-footer">
  <div class="site-footer__top">
    <a class="site-footer__logo" href={homeHref} aria-label="+CercaTV">
      <img src={path('/images/brand/cercatv-logo-dark.svg')} width="609" height="201" alt="Atresmedia +CercaTV" />
    </a>

    <nav class="site-footer__nav" aria-label="Footer">
      {items.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="site-footer__contact">
      <span>{translation.contact}</span>
      <a href="mailto:hola@publicidadsegmentadatv.com">hola@publicidadsegmentadatv.com</a>
      <a href="tel:+34777777777">+34 777 77 77</a>
    </div>

    <div class="site-footer__social">
      {socials.map((social) => (
        <a href={social.href} aria-label={social.label}>
          {social.label === 'X' && <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M18.9 2h3.3l-7.2 8.2L23.5 22h-6.6l-5.2-6.8L5.7 22H2.4l7.7-8.8L1 2h6.8l4.7 6.2L18.9 2Zm-1.2 18h1.8L7.4 4h-2l12.3 16Z"/></svg>}
          {social.label === 'LinkedIn' && <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.1c.5-.9 1.8-1.9 3.7-1.9 4 0 4.7 2.6 4.7 6V21h-4v-5.3c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8V21h-4V9Z"/></svg>}
          {social.label === 'Instagram' && <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1"/></svg>}
          {social.label === 'YouTube' && <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M22 12s0-3.4-.4-5a2.8 2.8 0 0 0-2-2C17.9 4.5 12 4.5 12 4.5s-5.9 0-7.6.5a2.8 2.8 0 0 0-2 2C2 8.6 2 12 2 12s0 3.4.4 5a2.8 2.8 0 0 0 2 2c1.7.5 7.6.5 7.6.5s5.9 0 7.6-.5a2.8 2.8 0 0 0 2-2c.4-1.6.4-5 .4-5Zm-12 3.2V8.8l6 3.2-6 3.2Z"/></svg>}
        </a>
      ))}
    </div>
  </div>

  <div class="site-footer__bottom">
    <a href={path('/aviso-legal')}>{translation.legal}</a>
    <a href={path('/politica-privacidad')}>{translation.privacy}</a>
    <a href={path('/politica-cookies')}>{translation.cookies}</a>
    {SHOW_MAP_CREDITS && (
      <p class="site-footer__credits">{translation.mapsLead}{' '}<a href="https://datos.madrid.es/" target="_blank" rel="noopener">Madrid</a>{', '}<a href="https://opendata-ajuntament.barcelona.cat/" target="_blank" rel="noopener">Barcelona</a>{' '}{translation.mapsAnd}{' '}<a href="https://datosabiertos.malaga.eu/" target="_blank" rel="noopener">{locale === 'ca' ? 'Màlaga' : 'Málaga'}</a>{' (CC BY 4.0).'}</p>
    )}
  </div>
</footer>

---
import '../../styles/global.css';
import '../../styles/tokens.css';
import '../../styles/header.css';
import '../../styles/footer.css';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Dominio de pruebas actual; confirmar dominio definitivo antes de quitar el noindex.
const siteOrigin = 'https://publicidadsegmentadatv.com';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: '+CercaTV',
  url: `${siteOrigin}${base}/ca/`,
  logo: `${siteOrigin}${base}/images/brand/cercatv-logo-color.svg`,
  description: 'Publicitat en televisió hiperlocal als canals d’Atresmedia, segmentada per codi postal, barri o ciutat.',
};
---
<!-- Traducció automàtica de referència (2026-09-15): pendent de revisió humana abans de publicar en producció. -->
<!doctype html>
<html lang="ca">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function () {
        if (sessionStorage.getItem('cercatv-auth') === '1') return;
        let ok = false;
        while (!ok) {
          const u = prompt('Usuario');
          const p = prompt('Contraseña');
          if (u === 'Cidoncha' && p === '007007') { sessionStorage.setItem('cercatv-auth', '1'); ok = true; }
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Publicitat en televisió hiperlocal als canals d'Atresmedia. Impacta als codis postals, barris o ciutats que t'interessen, sense necessitat de produir un espot." />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preload" href={`${base}/fonts/gothampro-regular.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}/fonts/gothampro-bold.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="alternate" hreflang="es" href={`${siteOrigin}${base}/`} />
    <link rel="alternate" hreflang="en" href={`${siteOrigin}${base}/en/`} />
    <link rel="alternate" hreflang="ca" href={`${siteOrigin}${base}/ca/`} />
    <title>Publicitat en televisió hiperlocal als canals d'Atresmedia | +CercaTV</title>
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </head>
  <body>
    <Header locale="ca" />
    <main>
      <section class="hero" id="overview" data-i18n-section="overview">
        <div class="hero__content">
          <div class="eyebrow">Televisió hiperlocal · als canals d'Atresmedia</div>
          <h1><span>Fes publicitat a la televisió</span><span>només on genera negoci</span></h1>
          <p>Impacta als codis postals, barris o ciutats que t'interessen. Sense necessitat de produir un espot.</p>
          <div class="hero__actions">
            <a class="hero__primary-action" href="#contacte">Vull estudiar la meva campanya</a>
            <a class="hero__secondary-action" href="#process">Veure com funciona <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="hero__signal" aria-hidden="true"><span></span><span></span><span></span></div>
      </section>

      <section class="benefits" id="benefits" aria-labelledby="benefits-title" data-i18n-section="benefits" data-reveal>
        <h2 id="benefits-title">Per què cada vegada més marques fan servir la televisió hiperlocal?</h2>
        <div class="benefits__grid">
          <article class="benefit"><div class="benefit__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2"/></svg></div><h3>Impacta on més pots vendre</h3><p>No malgastes inversió en zones on el teu negoci no opera.</p></article>
          <article class="benefit"><div class="benefit__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-8 9-4.5-1.5-8-4-8-9V5l8-3 8 3z"/><path d="m8.5 12 2.2 2.2 4.8-4.8"/></svg></div><h3>Credibilitat de la televisió</h3><p>Amb la precisió i mesura del màrqueting digital.</p></article>
          <article class="benefit"><div class="benefit__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="13" rx="2"/><path d="m9 21 3-3 3 3M8 9l3 2 5-3"/></svg></div><h3>Més persones, més atenció</h3><p>A la pantalla principal de la llar, amb impacte real.</p></article>
        </div>
      </section>

      <section class="power" id="atresmedia" aria-labelledby="power-title" data-i18n-section="atresmedia" data-reveal>
        <div class="power__intro"><span class="eyebrow">Atresmedia</span><h2 id="power-title">La potència d'Atresmedia.<br /><em>La precisió del màrqueting digital.</em></h2></div>
        <div class="power__stats"><article class="power-stat"><strong>27M</strong><span>Audiència</span></article><article class="power-stat"><strong>Prime</strong><span>Entorn premium</span></article><article class="power-stat"><strong>100%</strong><span>Seguretat de marca</span></article><article class="power-stat"><strong>Núm. 1 TV</strong><span>Autoritat</span></article></div>
      </section>

      <section class="cases" id="cases" aria-labelledby="cases-title" data-i18n-section="cases" data-reveal>
        <div class="cases__heading"><span class="eyebrow">Històries reals</span><h2 id="cases-title">Casos d'èxit</h2></div>
        <div class="cases__grid">
          <article class="case-card"><div class="case-card__top"><span>Clíniques</span><strong data-prefix="+" data-value="38" data-suffix="%">+38%</strong></div><div class="case-card__body"><h3>Clínica Norte</h3><p>Cites en 6 setmanes · Madrid Nord</p></div></article>
          <article class="case-card"><div class="case-card__top"><span>Automoció</span><strong data-prefix="×" data-value="2.7" data-decimals="1">×2.7</strong></div><div class="case-card__body"><h3>Auto Ibérica</h3><p>Leads qualificats · Llevant</p></div></article>
          <article class="case-card"><div class="case-card__top"><span>Restauració</span><strong data-prefix="+" data-value="27" data-suffix="%">+27%</strong></div><div class="case-card__body"><h3>Panadería 1908</h3><p>Trànsit a la botiga · 4 barris</p></div></article>
        </div>
        <div class="cases__footer"><a class="cta-pill" href={`${base}/casos-de-exito`}>Veure tots els casos d'èxit</a></div>
      </section>

      <section class="process" id="process" aria-labelledby="process-title" data-i18n-section="process" data-reveal>
        <div class="process__intro"><span class="eyebrow">El procés</span><h2 id="process-title">Així de senzill</h2></div>
        <ol class="process__list">
          <li class="process-step"><span>01</span><div><h3>Triem la zona</h3><p>Codis postals, barris o ciutats.</p></div></li>
          <li class="process-step"><span>02</span><div><h3>Definim el públic</h3><p>Perfil, hàbits i moment de consum.</p></div></li>
          <li class="process-step"><span>03</span><div><h3>Creem la campanya</h3><p>Creativitats específiques per a TV.</p></div></li>
          <li class="process-step"><span>04</span><div><h3>L'activem</h3><p>Als canals d'Atresmedia. En 72h.</p></div></li>
          <li class="process-step"><span>05</span><div><h3>Mesurem resultats</h3><p>KPIs de negoci, no de vanitat.</p></div></li>
        </ol>
      </section>

      <section class="decision-strip" id="talk" data-i18n-section="talk" data-reveal>
        <div class="decision-strip__inner">
          <span class="eyebrow">Parlem?</span>
          <h2>Descobreix si la televisió hiperlocal té sentit per al teu negoci</h2>
          <a class="cta-pill" href="#contacte"><span class="cta-pill__full">Estudiar el meu cas sense compromís</span><span class="cta-pill__short">Estudiar el meu cas</span></a>
        </div>
      </section>
    </main>

    <Footer locale="ca" />

    <script>
      const modules = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        modules.forEach((module) => module.classList.add('is-ready'));
        const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
          if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
        }), { threshold: 0.12 });
        modules.forEach((module) => observer.observe(module));
      }

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const countEls = document.querySelectorAll<HTMLElement>('.case-card__top strong[data-value]');
      const formatCount = (el: HTMLElement, value: number) => {
        const decimals = Number(el.dataset.decimals ?? '0');
        return `${el.dataset.prefix ?? ''}${value.toFixed(decimals)}${el.dataset.suffix ?? ''}`;
      };
      const animateCount = (el: HTMLElement) => {
        const target = Number(el.dataset.value);
        if (prefersReducedMotion) { el.textContent = formatCount(el, target); return; }
        const duration = 1200;
        const start = performance.now();
        const step = (now: number) => {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = formatCount(el, target * eased);
          if (progress < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };
      const countObserver = new IntersectionObserver((entries) => entries.forEach((entry) => {
        if (entry.isIntersecting) { animateCount(entry.target as HTMLElement); countObserver.unobserve(entry.target); }
      }), { threshold: 0.4 });
      countEls.forEach((el) => countObserver.observe(el));
    </script>
  </body>
</html>

---
import { getCollection } from 'astro:content';
import '../styles/global.css';
import '../styles/tokens.css';
import '../styles/header.css';
import '../styles/footer.css';
import Header from '../components/Header.astro';
import AuthGate from '../components/AuthGate.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteOrigin = 'https://publicidadsegmentadatv.com';

const pinIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12z"/><circle cx="12" cy="9" r="2.5"/></svg>';
const chartIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>';
const arrowIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';

const casosCollection = await getCollection('casos');
const cases = casosCollection
  .map((entry) => {
    const d = entry.data;
    return {
      index: d.index,
      category: d.categoria,
      slugCategory: d.categoriaSlug,
      title: d.titulo,
      subtitle: d.subtitulo,
      prefix: d.resultadoPrefijo,
      value: d.resultadoValor,
      suffix: d.resultadoSufijo,
      decimals: d.resultadoDecimales,
      statDesc: d.resultadoDescripcion,
      progress: d.progreso,
      slug: entry.id,
    };
  })
  .sort((a, b) => a.index.localeCompare(b.index));

const filters = [
  { label: 'Todos', value: 'todos' },
  { label: 'Retail', value: 'retail' },
  { label: 'Franquicias', value: 'franquicias' },
  { label: 'Clínicas', value: 'clinicas' },
  { label: 'Automoción', value: 'automocion' },
  { label: 'Restauración', value: 'restauracion' },
  { label: 'Hostelería', value: 'hosteleria' },
].map((filter) => ({
  ...filter,
  count: filter.value === 'todos' ? cases.length : cases.filter((item) => item.slugCategory === filter.value).length,
}));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <AuthGate />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Casos de éxito reales de marcas que usan televisión hiperlocal en los canales de Atresmedia para generar más negocio." />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preload" href={`${base}/fonts/gothampro-regular.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}/fonts/gothampro-bold.woff2`} as="font" type="font/woff2" crossorigin />
    <title>Casos de éxito | +CercaTV</title>
  </head>
  <body class="page-wide">
    <Header />

    <main>
      <section class="case-archive" id="casos" aria-labelledby="case-archive-title" data-reveal>
        <div class="case-archive__intro">
          <span class="eyebrow">Historias reales</span>
          <h2 id="case-archive-title">Todos los casos de éxito</h2>
          <p>Empresas que ya multiplican resultados con televisión hiperlocal en los canales de Atresmedia.</p>
        </div>

        <div class="case-filter-wrap">
          <div class="case-filter" role="group" aria-label="Filtrar casos por sector">
            <span class="case-filter__thumb" aria-hidden="true"></span>
            {filters.map((filter, index) => (
              <button type="button" data-filter={filter.value} aria-pressed={index === 0 ? 'true' : 'false'}>
                <span class="case-filter__label">{filter.label}</span>
                <span class="case-filter__count">{filter.count}</span>
              </button>
            ))}
          </div>
        </div>

        <div class="case-archive__grid">
          {cases.map((item) => (
            <article class="case-tile" data-category={item.slugCategory}>
              <div class="case-tile__head">
                <span class="case-tile__badge">Caso de éxito</span>
                <span class="case-tile__index">{item.index}</span>
              </div>

              <div class="case-tile__intro">
                <div>
                  <span class="case-tile__category">{item.category}</span>
                  <h3 class="case-tile__title">{item.title}</h3>
                </div>
                <div class="case-tile__logo case-tile__logo--placeholder" aria-hidden="true">Tu logo aquí</div>
              </div>
              <p class="case-tile__subtitle">{item.subtitle}</p>

              <div class="case-tile__stat">
                <strong data-prefix={item.prefix} data-value={item.value} data-suffix={item.suffix} data-decimals={item.decimals}>{item.prefix}{item.value.toFixed(item.decimals)}{item.suffix}</strong>
                <p>{item.statDesc}</p>
                <div class="case-tile__progress">
                  <div class="case-tile__progress-track"><div class="case-tile__progress-fill" data-progress={item.progress} style="width:0%"></div></div>
                  <span>Más resultados</span>
                </div>
              </div>

              <div class="case-tile__meta">
                <div class="case-tile__meta-item"><span class="case-tile__meta-icon" aria-hidden="true" set:html={pinIcon} /><span>Cobertura hiperlocal</span></div>
                <span class="case-tile__meta-divider" aria-hidden="true"></span>
                <div class="case-tile__meta-item"><span class="case-tile__meta-icon" aria-hidden="true" set:html={chartIcon} /><span>Campaña TV segmentada</span></div>
              </div>

              <div class="case-tile__footer">
                <a class="case-tile__link" href={`${base}/casos-de-exito/${item.slug}`}>
                  Ver caso completo
                  <span class="case-tile__link-icon" aria-hidden="true" set:html={arrowIcon} />
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="decision-strip" id="talk" data-reveal>
        <div class="decision-strip__inner">
          <span class="eyebrow">¿Hablamos?</span>
          <h2>Descubre si la televisión hiperlocal tiene sentido para tu negocio</h2>
          <a class="cta-pill" href={`${base}/contacto`}><span class="cta-pill__full">Estudiar mi caso sin compromiso</span><span class="cta-pill__short">Estudiar mi caso</span></a>
        </div>
      </section>
    </main>

    <Footer />

    <script>
      const modules = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        modules.forEach((module) => module.classList.add('is-ready'));
        const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
          if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
        }), { threshold: 0.12 });
        modules.forEach((module) => observer.observe(module));
      }

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const formatCount = (el: HTMLElement, value: number) => {
        const decimals = Number(el.dataset.decimals ?? '0');
        return `${el.dataset.prefix ?? ''}${value.toFixed(decimals)}${el.dataset.suffix ?? ''}`;
      };
      const animateValue = (draw: (progress: number) => void, duration = 1200) => {
        if (prefersReducedMotion) { draw(1); return; }
        const start = performance.now();
        const step = (now: number) => {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          draw(eased);
          if (progress < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };
      const animateTile = (tile: HTMLElement) => {
        const countEl = tile.querySelector<HTMLElement>('.case-tile__stat strong[data-value]');
        const fillEl = tile.querySelector<HTMLElement>('.case-tile__progress-fill[data-progress]');
        if (countEl) {
          const target = Number(countEl.dataset.value);
          animateValue((progress) => { countEl.textContent = formatCount(countEl, target * progress); });
        }
        if (fillEl) {
          const target = Number(fillEl.dataset.progress);
          animateValue((progress) => { fillEl.style.width = `${target * progress}%`; });
        }
      };
      const tileObserver = new IntersectionObserver((entries) => entries.forEach((entry) => {
        if (entry.isIntersecting) { animateTile(entry.target as HTMLElement); tileObserver.unobserve(entry.target); }
      }), { threshold: 0.35 });
      document.querySelectorAll<HTMLElement>('.case-tile').forEach((tile) => tileObserver.observe(tile));

      const filterGroup = document.querySelector<HTMLElement>('.case-filter');
      const filterThumb = document.querySelector<HTMLElement>('.case-filter__thumb');
      const filterButtons = document.querySelectorAll<HTMLButtonElement>('.case-filter button');
      const tiles = document.querySelectorAll<HTMLElement>('.case-tile');

      const moveThumb = (button: HTMLButtonElement) => {
        if (!filterThumb || !filterGroup) return;
        const groupRect = filterGroup.getBoundingClientRect();
        const buttonRect = button.getBoundingClientRect();
        filterThumb.style.width = `${buttonRect.width}px`;
        filterThumb.style.transform = `translateX(${buttonRect.left - groupRect.left}px)`;
      };

      const activeButton = document.querySelector<HTMLButtonElement>('.case-filter button[aria-pressed="true"]');
      if (activeButton) requestAnimationFrame(() => moveThumb(activeButton));
      window.addEventListener('resize', () => {
        const current = document.querySelector<HTMLButtonElement>('.case-filter button[aria-pressed="true"]');
        if (current) moveThumb(current);
      });

      filterButtons.forEach((button) => button.addEventListener('click', () => {
        filterButtons.forEach((b) => b.setAttribute('aria-pressed', 'false'));
        button.setAttribute('aria-pressed', 'true');
        moveThumb(button);
        button.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', inline: 'center', block: 'nearest' });
        const value = button.dataset.filter;
        tiles.forEach((tile) => {
          const show = value === 'todos' || tile.dataset.category === value;
          tile.hidden = !show;
        });
      }));
    </script>
  </body>
</html>
